<Window x:Class="DynamicIsland.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island · 테마 꾸미기"
        Width="1020" Height="740" MinWidth="860" MinHeight="540"
        Background="#15151B" Foreground="#EDEDF2"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 테마 목록 -->
        <Border Background="#1A1A22" BorderBrush="#262631" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,12">
                <TextBlock DockPanel.Dock="Top" Text="내 테마" FontSize="17" FontWeight="SemiBold" Margin="5,0,0,12"/>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="새 테마" Click="New_Click"/>
                    <Button Content="복제" Click="Duplicate_Click"/>
                    <Button Content="삭제" Click="Delete_Click"/>
                    <Button Content="가져오기" Click="Import_Click"/>
                    <Button Content="내보내기" Click="Export_Click"/>
                    <Button Content="기본 테마 복원" Click="Restore_Click"/>
                </WrapPanel>
                <ListBox x:Name="ThemeList" DisplayMemberPath="Name" SelectionChanged="ThemeList_SelectionChanged"/>
            </DockPanel>
        </Border>

        <!-- 오른쪽: 편집 -->
        <DockPanel Grid.Column="1">
            <Grid DockPanel.Dock="Top" Margin="28,20,22,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Chip}" GroupName="tabs" Content="섬 모양" Tag="Look" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton Style="{StaticResource Chip}" GroupName="tabs" Content="캐릭터" Tag="Chars" Checked="Tab_Checked"/>
                    <RadioButton Style="{StaticResource Chip}" GroupName="tabs" Content="장식" Tag="Decor" Checked="Tab_Checked"/>
                    <RadioButton Style="{StaticResource Chip}" GroupName="tabs" Content="앱 설정" Tag="Settings" Checked="Tab_Checked"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="펼쳐 보기" Click="Peek_Click"/>
                    <Button Content="제어 센터 보기" Click="PeekControl_Click"/>
                    <Button Content="알림 테스트" Click="TestNotification_Click" Margin="0,0,0,6"/>
                </StackPanel>
            </Grid>
            <TextBlock DockPanel.Dock="Bottom" Margin="28,8,22,14" FontSize="12" Opacity="0.5"
                       Text="바꾼 내용은 화면 맨 위 아일랜드에 바로 반영되고 자동으로 저장돼요."/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Body" Margin="28,18,28,24"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
